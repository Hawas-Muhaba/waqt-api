{
 "suite": "open-questions",
 "tier": "open",
 "vectors": [
  {
   "id": "date/basic-format-20260101",
   "requirements": [
    "TIME-003"
   ],
   "op": "gregorian.weekday",
   "tier": "open",
   "basis": "spec",
   "input": {
    "date": "20260101"
   },
   "expect": {
    "error": {
     "code": [
      "INVALID_DATE",
      "VALIDATION_ERROR"
     ]
    }
   },
   "note": "PROPOSED: reject. The wire format is stated as YYYY-MM-DD; whether ISO-8601 basic format is tolerated is not stated. The reference accepts it (Python fromisoformat)."
  },
  {
   "id": "instant/fraction-echo",
   "requirements": [
    "TIME-001"
   ],
   "op": "instant.parse",
   "tier": "open",
   "basis": "spec",
   "input": {
    "value": "2026-09-19T15:42:00.123456Z"
   },
   "expect": {
    "output": {
     "instant": "2026-09-19T15:42:00.123456+00:00"
    }
   },
   "note": "PROPOSED: sub-second input is preserved. The reference /v1/waqt response echoes the instant truncated to whole seconds."
  },
  {
   "id": "instant/naive",
   "requirements": [
    "TIME-002"
   ],
   "op": "instant.parse",
   "tier": "open",
   "basis": "spec",
   "input": {
    "value": "2026-09-19T15:42:00"
   },
   "expect": {
    "error": {
     "code": [
      "INVALID_INSTANT",
      "VALIDATION_ERROR"
     ]
    }
   },
   "note": "PROPOSED: reject. API.md says instant is 'ISO 8601 UTC' but never says whether an offset-less string is rejected or assumed UTC. The reference assumes UTC."
  },
  {
   "id": "default/out-of-range/date-to-waqt-day/addis/1699-09-19",
   "requirements": [
    "CAL-012"
   ],
   "op": "calendar.gregorian_date_to_waqt_day",
   "tier": "open",
   "basis": "spec",
   "input": {
    "date": "1699-09-19",
    "location": {
     "lat": 9.0192,
     "lon": 38.7525
    },
    "timezone": "Africa/Addis_Ababa"
   },
   "expect": {
    "output": {
     "resolved": true,
     "hijri_date": null
    }
   },
   "note": "PROPOSED: the Waqt day is returned with an empty Hijri label (a calendar failure never fails a Waqt computation; API 1.5.0 calendar_error). The reference does this; the independent implementation returns OUT_OF_RANGE. OQ-CAL-1."
  },
