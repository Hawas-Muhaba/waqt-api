  {
   "id": "next-event/tonights-isha",
   "requirements": [
    "EVT-007"
   ],
   "op": "waqt.compute",
   "tier": "open",
   "basis": "spec",
   "input": {
    "location": {
     "lat": 9.0192,
     "lon": 38.7525
    },
    "instant": "2026-09-19T15:42:00+00:00",
    "timezone": "Africa/Addis_Ababa",
    "profile": {
     "fajr_angle_deg": 18.0,
     "isha_angle_deg": 17.0,
     "asr_shadow_ratio": 1.0
    },
    "calendar": {
     "provider": "arithmetic-tabular"
    }
   },
   "expect": {
    "output": {
     "next_event": {
      "name": "isha",
      "instant": "2026-09-19T16:28:28+00:00"
     }
    }
   },
   "note": "Right after Maghrib the next event by OCCURRENCE is tonight's Isha (SCHEDULING.md 5 says exactly this for the scheduling layer). The waqt.compute response lists only the new day's events, so a listing-based next_event skips it and returns tomorrow's Fajr.",
   "tolerance": {
    "default": {
     "instant_s": 3,
     "abs": 3
    }
   }
  },
  {
   "id": "asr/degenerate-67N-solstice",
   "requirements": [
    "UND-004"
   ],
   "op": "waqt.compute",
   "tier": "open",
   "basis": "oracle",
   "input": {
    "location": {
     "lat": 67.0,
     "lon": 0.0
    },
    "instant": "2026-12-21T12:00:00+00:00",
    "timezone": "UTC",
    "profile": {
     "fajr_angle_deg": 18.0,
     "isha_angle_deg": 17.0,
     "asr_shadow_ratio": 1.0
    },
    "calendar": {
     "provider": "arithmetic-tabular"
    }
   },
   "expect": {
    "output": {
     "status": "OK",
     "undefined_events": [
      {
       "name": "asr"
      }
     ]
    }
   },
   "note": "Sun's noon altitude is -0.44 deg, equal to the (degenerate, negative) Asr target. PROPOSED: Asr is undefined when the Sun is not above the geometric horizon at transit. The independent implementation first returned an Asr here and was changed AFTER the latitude sweep exposed it."
  }
