{
 "suite": "legacy-interop",
 "tier": "exact",
 "description": "Sprint 8 calendar-interop vectors recomputed from coordinates.",
 "vectors": [
  {
   "id": "interop/instant/ordinary-conversion-addis",
   "requirements": [
    "INT-001",
    "DAY-007"
   ],
   "op": "calendar.represent_instant",
   "tier": "tolerance",
   "input": {
    "instant": "2026-03-01T12:00:00+00:00",
    "location": {
     "lat": 9.0084,
     "lon": 38.7575,
     "elevation_m": 2355
    },
    "timezone": "Africa/Addis_Ababa"
   },
   "expect": {
    "output": {
     "gregorian_utc": {
      "date": "2026-03-01",
      "time_of_day": "12:00:00",
      "weekday_iso": 7,
      "weekday_name_islamic": "al-Ahad",
      "is_leap_year": false,
      "timezone_name": null,
      "utc_offset_seconds": 0
     },
     "gregorian_civil": {
      "date": "2026-03-01",
      "time_of_day": "15:00:00",
      "weekday_iso": 7,
      "weekday_name_islamic": "al-Ahad",
      "is_leap_year": false,
      "timezone_name": "Africa/Addis_Ababa",
      "utc_offset_seconds": 10800
     },
     "waqt_status": "OK",
     "waqt_position_seconds": 73098.286
    }
   },
   "tolerance": {
    "default": {
     "instant_s": 3,
     "abs": 3
    }
   },
   "note": "An ordinary midday instant converts cleanly to both a UTC/civil Gregorian date and a Waqt day."
  },
