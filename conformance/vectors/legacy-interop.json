  {
   "id": "interop/instant/timezone-vs-solar-dibrugarh",
   "requirements": [
    "INT-001",
    "DAY-007"
   ],
   "op": "calendar.represent_instant",
   "tier": "tolerance",
   "input": {
    "instant": "2026-04-10T12:00:00+00:00",
    "location": {
     "lat": 27.48,
     "lon": 94.9,
     "elevation_m": 108
    },
    "timezone": "Asia/Kolkata"
   },
   "expect": {
    "output": {
     "gregorian_utc": {
      "date": "2026-04-10",
      "time_of_day": "12:00:00",
      "weekday_iso": 5,
      "weekday_name_islamic": "al-Jumuah",
      "is_leap_year": false,
      "timezone_name": null,
      "utc_offset_seconds": 0
     },
     "gregorian_civil": {
      "date": "2026-04-10",
      "time_of_day": "17:30:00",
      "weekday_iso": 5,
      "weekday_name_islamic": "al-Jumuah",
      "is_leap_year": false,
      "timezone_name": "Asia/Kolkata",
      "utc_offset_seconds": 19800
     },
     "waqt_status": "OK",
     "waqt_position_seconds": 86204.44
    }
   },
   "tolerance": {
    "default": {
     "instant_s": 3,
     "abs": 3
    }
   },
   "note": "Dibrugarh (NE India) uses Asia/Kolkata (UTC+5:30) despite sitting near 95 deg E, where solar time runs roughly 50 minutes ahead of the civil clock; Waqt's Maghrib bracketing uses true solar geometry regardless of the political offset."
  },
